name: 一键自动修改并打包 ZZUPocket APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - name: 1. 拉取原项目源码
        uses: actions/checkout@v4

      - name: 2. 自动替换 6 个定制版源码文件（主页置顶 + 物理/化学/环保馆置顶）
        run: |
          python3 - << 'EOF'
          import base64, zlib, pathlib
          files = {
              "app/src/main/java/com/zzupocket/app/ui/nav/AppRoutes.kt": "",
              "app/src/main/java/com/zzupocket/app/domain/RoomModels.kt": "",
              "app/src/main/java/com/zzupocket/app/ui/campus/RoomViewModel.kt": "",
              "app/src/main/java/com/zzupocket/app/ui/campus/RoomScreen.kt": "",
              "app/src/main/java/com/zzupocket/app/ui/today/TodayScreen.kt": "",
              "app/src/main/java/com/zzupocket/app/ui/nav/AppNav.kt": "",
          }
          for rel_path, payload in files.items():
              p = pathlib.Path(rel_path)
              p.parent.mkdir(parents=True, exist_ok=True)
              p.write_bytes(zlib.decompress(base64.b64decode(payload)))
              print(f'Successfully updated: {rel_path}')
          EOF

      - name: 3. 配置 JDK 17 环境
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
          cache: 'gradle'

      - name: 4. 编译生成手机可直接安装的 APK
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug
          cp app/build/outputs/apk/debug/app-debug.apk ZZUPocket-物理化学环保馆置顶版.apk

      - name: 5. 上传 APK 到 Actions 产物
        uses: actions/upload-artifact@v4
        with:
          name: ZZUPocket-物理化学环保馆置顶版-APK
          path: ZZUPocket-物理化学环保馆置顶版.apk

      - name: 6. 自动发布 APK 到仓库 Releases（手机可直接点链接下载安装）
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v0.32.0-custom
          name: ZZUPocket 定制版（空教室主页置顶 + 物理/化学/环保馆置顶）
          body: |
            ### 定制修改内容
            - **主页最显眼入口**：「今天」首页顶部新增空教室速查大卡片，底部导航栏新增「教室」一级常驻入口。
            - **物理馆、化学馆、环保馆置顶**：默认锁定并置顶这三栋常用馆，支持顶部常驻快捷栏一键切换。
            - **自习体验升级**：支持「连空2节 / 当下空闲 / 上下午」一键筛选、房间号搜索、连续空闲节数显示与排序。
            
            **安装提示**：请直接点击下方 `ZZUPocket-物理化学环保馆置顶版.apk` 下载安装（若手机已安装原版，请先卸载原版再安装）。
          files: ZZUPocket-物理化学环保馆置顶版.apk
